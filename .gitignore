# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Build / packaging
build/
dist/
*.spec.bak

# Tickmark output — reports are written wherever the user asks; never commit them
*.tickmark.html
/reports/

# Test fixtures generated at runtime
/tests/_generated/

# Benchmark scratch — audit_bench.py writes its generated workbook here
/bench.xlsx

# CI writes the test output here so failures can be echoed as annotations
/pytest.log

# The sample workbook is generated by demo/build_demo.py. The published copy
# under docs/ is committed because GitHub Pages serves it; this one is scratch.
/demo/*.xlsx

# OS
Thumbs.db
desktop.ini
